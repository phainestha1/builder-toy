# 로컬 환경변수 예시. 이 파일을 .env.local로 복사하고 값을 채운다 (.env.local은 커밋하지 않는다).
# 준비 방법은 README "로컬 환경변수"를 본다.

# next-auth 서명용 시크릿. 32자 이상 임의 문자열 (예: openssl rand -base64 32)
NEXTAUTH_SECRET=

# 상담원 계정 (JSON 배열, 한 줄). passwordHash는 `npm run hash-password -- '<비밀번호>'` 결과
# 예: COUNSELOR_ACCOUNTS='[{"username":"counselor1","counselorId":"counselor-1","name":"김상담","passwordHash":"<salt:hash>"}]'
COUNSELOR_ACCOUNTS=

# SQLite 파일 위치 (기본값 ./data/builder-toy.db)
DATABASE_PATH=./data/builder-toy.db

# E2E 서버 포트. Builder A는 3101, Builder B는 3102
E2E_PORT=

# 테스트 전용 시드 라우트(/admin/e2e-seed). 평소에는 비워 둔다. E2E는 playwright가 webServer에 1로 넘긴다
E2E_SEED_ENABLED=

# E2E가 로그인할 상담원 계정 (COUNSELOR_ACCOUNTS에 있는 계정의 아이디와 원래 비밀번호)
E2E_COUNSELOR_USERNAME=
E2E_COUNSELOR_PASSWORD=
